# Xiaomi Hardware ID Driver configuration
#

config MI_HARDWARE_ID
	tristate "Xiaomi Hardware ID driver"
	default m
	help
	  Say Y or M here to support Xiaomi Hardware ID detection.
	  This driver exposes hardware revision, project ID, and ADC values
	  via sysfs attributes under /sys/devices/platform/hwid/.

	  To compile this driver as a module, choose M here: the module
	  will be called hwid.
